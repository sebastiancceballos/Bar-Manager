// This file documents the real production schema (Postgres/Neon).
// NOTE: This project does NOT use Prisma Client at runtime — every API route
// talks to the database with raw SQL via `lib/db.ts` (@neondatabase/serverless).
// Neither `prisma` nor `@prisma/client` are even in package.json.
// This schema exists only as documentation/reference. The real source of
// truth for the schema is the numbered files in /scripts (01 -> 07), which
// is also where any future column/table changes should be added.
//
// If you want to actually use Prisma Client, run:
//   npm install prisma @prisma/client
//   npx prisma db pull   (to sync this file with the live DB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String
  role          String   @default("waiter") // "owner" | "admin" | "waiter"
  location_id   Int?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  location        Location?      @relation("LocationUsers", fields: [location_id], references: [id], onDelete: SetNull)
  ownedLocations  Location[]     @relation("LocationOwner")
  ordersTaken     Order[]        @relation("OrderWaiter")
  ordersModified  Order[]        @relation("OrderModifier")
  stockMovements  StockMovement[]

  @@map("users")
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  active    Boolean  @default(true)
  self_service_enabled Boolean @default(true)
  owner_id  Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner    User?         @relation("LocationOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  users    User[]        @relation("LocationUsers")
  tables   Table[]
  products Product[]
  income   DailyIncome[]

  @@map("locations")
}

model Table {
  id           Int      @id @default(autoincrement())
  location_id  Int
  table_number String
  capacity     Int      @default(4)
  x_position   Float    @default(0)
  y_position   Float    @default(0)
  width        Float    @default(80)
  height       Float    @default(80)
  status       String   @default("available")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([location_id, table_number])
  @@map("tables")
}

model Product {
  id          Int      @id @default(autoincrement())
  location_id Int
  name        String
  category    String
  price       Float
  description String?
  stock       Int      @default(0)
  image_url   String?  // usado por el menú público de autoservicio
  available   Boolean  @default(true) // visible/ocultable del menú de autoservicio
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  location       Location        @relation(fields: [location_id], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model Order {
  id           Int       @id @default(autoincrement())
  table_id     Int?      // nullable: los pedidos de autoservicio no tienen mesa
  waiter_id    Int?      // nullable: los pedidos de autoservicio no tienen mesero
  status       String    @default("open")
  // dine_in:      "open" | "closed" | "paid"
  // self_service: "PENDING_PAYMENT" | "PAID" | "PREPARING" | "READY" | "COMPLETED" | "CANCELLED"
  order_type      String   @default("dine_in") // "dine_in" | "self_service"
  ticket_number   String?  @unique // ej. "#0042", solo self_service
  public_token    String?  @unique // UUID impredecible para la URL de /tracking
  client_name     String?
  customer_notes  String?
  total_amount Float     @default(0)
  modified_by  Int?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  closed_at    DateTime?

  table    Table       @relation(fields: [table_id], references: [id], onDelete: Cascade)
  waiter   User        @relation("OrderWaiter", fields: [waiter_id], references: [id], onDelete: SetNull)
  modifier User?       @relation("OrderModifier", fields: [modified_by], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int      @default(1)
  price      Float
  status     String   @default("pendiente") // "pendiente" | "preparando" | "listo" | "entregado"
  notes      String?  // notas de personalización del cliente (autoservicio)
  createdAt  DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model StockMovement {
  id         Int      @id @default(autoincrement())
  product_id Int?
  quantity   Int
  type       String // "sale" | "entry"
  reason     String?
  created_by Int?
  createdAt  DateTime @default(now()) @map("created_at")

  product   Product? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  createdByUser User? @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("stock_movements")
}

model DailyIncome {
  id           Int      @id @default(autoincrement())
  location_id  Int
  date         DateTime
  total_income Float    @default(0)
  order_count  Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([location_id, date])
  @@map("daily_income")
}
